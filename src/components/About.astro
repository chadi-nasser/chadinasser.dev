---
import SectionHeader from "@/components/SectionHeader.astro";
import site from "@/data/site.json";

---

<section class="section" id="about">
  <div class="container">
    <SectionHeader
      kicker="01 / About"
      title="Backend systems, built to stay up."
    />

    <div class="about-grid">
      <div class="about-copy">
        <p class="about-lead">{site.about.lead}</p>
      </div>

      <ul class="about-principles" aria-label="How I work">
        <li><span class="about-principle-num">01</span> Observable by default</li>
        <li><span class="about-principle-num">02</span> Boring on purpose</li>
        <li><span class="about-principle-num">03</span> Design before code</li>
      </ul>
    </div>
  </div>
</section>
