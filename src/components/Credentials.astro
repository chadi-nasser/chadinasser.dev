---
import Icon from "@/components/Icon.astro";
import SectionHeader from "@/components/SectionHeader.astro";

interface EducationItem {
  degree: string;
  period: string;
  institution: string;
  gpa: string;
}

interface Certification {
  title: string;
  issuer: string;
  date: string;
  credentialId: string;
  verifyUrl?: string;
}

interface Props {
  education: {
    items: EducationItem[];
  };
  certifications: Certification[];
}

const { education, certifications } = Astro.props;
---

<section class="section section--surface" id="credentials">
  <div class="container">
    <SectionHeader
      kicker="04 / Credentials"
      title="Education and certifications"
      intro="Formal computer science training, plus hands-on cloud and platform certifications."
    />

    <div class="credentials-grid">
      <div>
        <p class="credentials-col-title">Education</p>
        <div class="credential-list">
          {
            education.items.map((item) => (
              <div class="credential">
                <div>
                  <p class="credential-title">{item.degree}</p>
                  <p class="credential-meta">{item.institution}</p>
                </div>
                <p class="credential-meta">{item.period}</p>
                <p class="credential-id">GPA {item.gpa}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <p class="credentials-col-title">Certifications</p>
        <div class="credential-list">
          {
            certifications.map((item) => (
              <div class="credential">
                <div>
                  <p class="credential-title">{item.title}</p>
                  <p class="credential-meta">
                    {item.issuer} · {item.date}
                  </p>
                </div>
                <p class="credential-id">Credential {item.credentialId}</p>
                {item.verifyUrl ? (
                  <a
                    class="credential-id"
                    href={item.verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Verify ${item.title}`}
                  >
                    Verify <Icon name="external" size={12} />
                  </a>
                ) : (
                  <span />
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
