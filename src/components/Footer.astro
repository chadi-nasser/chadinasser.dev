---
import site from "@/data/site.json";

const year = new Date().getFullYear();
const links = [
  { href: site.person.githubUrl, label: "GitHub" },
  { href: site.person.linkedinUrl, label: "LinkedIn" },
  { href: `mailto:${site.person.email}`, label: "Email" },
  { href: "https://github.com/chadi-nasser/chadinasser.dev", label: "Source" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-meta">
      <p>© {year} Chadi Nasser. All rights reserved.</p>
      <p>{site.person.location} · Static HTML &amp; CSS · No tracking</p>
    </div>
    <nav class="footer-links" aria-label="Elsewhere">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http")
              ? "noopener noreferrer"
              : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
