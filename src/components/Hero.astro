---
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.png";
import Icon from "@/components/Icon.astro";
import site from "@/data/site.json";

const { person, experience } = site;
const current = experience.items[0];
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        {site.contact.availability} · Backend, DevOps &amp; AI
      </p>
      <h1 class="hero-title">{person.name}</h1>
      <p class="hero-subtitle">{person.headline}</p>
      <p class="hero-line">
        Backend and DevOps engineer with 6+ years building Java and Spring Boot
        systems. I work across security, data platforms, and applied AI.
        Currently a {current.role} at {current.company}.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`mailto:${person.email}`}>
          <Icon name="mail" />
          Email me
        </a>
        <a class="btn btn-secondary" href="/cv">
          <Icon name="file" />
          View CV
        </a>
        <a
          class="btn btn-ghost"
          href={person.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </div>

    <aside class="hero-card" aria-label="Profile summary">
      <div class="hero-card-head">
        <Image
          src={avatar}
          alt={person.name}
          width={128}
          height={128}
          format="webp"
          loading="eager"
          class="avatar"
        />
        <div>
          <p class="hero-card-name">{person.name}</p>
          <p class="hero-card-role">{person.title}</p>
        </div>
      </div>
      <dl class="fact-list">
        <div class="fact">
          <dt class="fact-label">Now</dt>
          <dd class="fact-value">{current.company}</dd>
        </div>
        <div class="fact">
          <dt class="fact-label">Based</dt>
          <dd class="fact-value">{person.location}</dd>
        </div>
        <div class="fact">
          <dt class="fact-label">Focus</dt>
          <dd class="fact-value">Java, Security, Data, AI</dd>
        </div>
        <div class="fact">
          <dt class="fact-label">Certified</dt>
          <dd class="fact-value">CKA, DevOps Engineer</dd>
        </div>
        <div class="fact">
          <dt class="fact-label">Email</dt>
          <dd class="fact-value">
            <a href={`mailto:${person.email}`}>{person.email}</a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
