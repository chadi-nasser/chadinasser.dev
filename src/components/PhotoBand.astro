---
import { Image } from "astro:assets";
import pigeon from "../../assets/pigeon-rocks-beirut-lebanon-loc-matpc-13089.jpg";
import site from "@/data/site.json";

const photo = site.media.archivalPhotos[0];
---

<figure class="photo-band photo-figure">
  <Image
    src={pigeon}
    alt="Pigeon Rocks, Beirut, Lebanon, 1925"
    width={1600}
    height={700}
    widths={[800, 1200, 1600]}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
  />
  <figcaption class="container photo-caption">
    Pigeon Rocks, Beirut, 1925. {photo.creator}, public domain, via Wikimedia
    Commons. <a href={photo.page} target="_blank" rel="noopener noreferrer">Source</a>
  </figcaption>
</figure>
