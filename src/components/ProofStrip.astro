---
const proof = [
  { value: "5+", label: "Years building backend systems" },
  { value: "Data", label: "Snowflake · PostgreSQL" },
  { value: "AWS", label: "Cloud · Docker · CI/CD" },
  { value: "Security", label: "JWT · OAuth2 · OIDC" },
];
---

<div class="container">
  <div class="proof-strip">
    {
      proof.map((item) => (
        <div class="proof-item">
          <span class="proof-value">{item.value}</span>
          <span class="proof-label">{item.label}</span>
        </div>
      ))
    }
  </div>
</div>
