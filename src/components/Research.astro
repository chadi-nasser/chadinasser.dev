---
import SectionHeader from "@/components/SectionHeader.astro";
import site from "@/data/site.json";

const { research } = site;
---

<section class="section" id="research">
  <div class="container">
    <SectionHeader
      kicker="05 / Research & AI"
      title="Sentence transformers for retrieval"
      intro="M.S. research on adapting sentence transformers for Qdrant-based information retrieval."
    />

    <div class="research-grid">
      <div class="research-copy">
        <p>{research.summary}</p>
      </div>

      <div class="research-meta">
        <div>
          <span class="fact-label">Context</span>
          <p>{research.context}</p>
        </div>
        <div>
          <span class="fact-label">Topics</span>
          <div class="toolkit-items">
            {research.topics.map((topic) => <span class="tag">{topic}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
