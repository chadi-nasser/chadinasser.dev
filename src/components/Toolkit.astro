---
import SectionHeader from "@/components/SectionHeader.astro";

interface ToolkitItem {
  tool: string;
  layer: string;
  usedFor: string;
}

interface Props {
  items: ToolkitItem[];
}

const { items } = Astro.props;

const capabilityGroups = [
  {
    title: "Build secure services",
    tools: [
      "Java",
      "Spring Boot",
      "Jackson",
      "Apache POI",
      "RestTemplate",
      "JUnit 5",
      "Mockito",
      "Maven",
    ],
  },
  {
    title: "Secure the stack",
    tools: ["JWT", "OAuth2", "OIDC", "TOTP", "Passkeys", "Bucket4j"],
  },
  {
    title: "Work with data",
    tools: [
      "PostgreSQL",
      "MySQL",
      "MongoDB",
      "Snowflake",
      "Flyway",
      "Liquibase",
      "Qdrant",
    ],
  },
  {
    title: "Ship and operate",
    tools: [
      "Docker",
      "Kubernetes",
      "Jenkins",
      "AWS",
      "Terraform",
      "Linux",
      "SLF4J",
      "Logback",
    ],
  },
  {
    title: "Apply AI",
    tools: [
      "RAG",
      "AI agents",
      "Embedding models",
      "Fine-tuning",
      "Vector search",
      "Python",
    ],
  },
  {
    title: "Web & systems",
    tools: ["TypeScript", "Rust", "Astro", "Next.js", "React"],
  },
];

const byTool = new Map(items.map((item) => [item.tool, item]));
const groupedTools = new Set(capabilityGroups.flatMap((group) => group.tools));
const ungrouped = items.filter((item) => !groupedTools.has(item.tool));

if (ungrouped.length > 0) {
  throw new Error(
    `Toolkit tools missing a capability group: ${ungrouped.map((item) => item.tool).join(", ")}`,
  );
}

const groups = capabilityGroups.map((group) => ({
  title: group.title,
  items: group.tools
    .map((tool) => byTool.get(tool))
    .filter((item): item is ToolkitItem => item !== undefined),
}));
---

<section class="section section--surface" id="toolkit">
  <div class="container">
    <SectionHeader
      kicker="06 / Toolkit"
      title="Tools I reach for"
      intro="A working stack rather than a logo wall. The common thread is systems that are understandable, observable, and boring to operate."
    />

    <div class="toolkit-grid">
      {
        groups.map((group) => (
          <div class="toolkit-card">
            <p class="toolkit-card-title">{group.title}</p>
            <div class="toolkit-items">
              {group.items.map((item) => (
                <span class="tag" title={item.usedFor}>
                  {item.tool}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
