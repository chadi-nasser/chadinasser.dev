---
import SectionHeader from "@/components/SectionHeader.astro";

interface ToolkitItem {
  tool: string;
  layer: string;
  usedFor: string;
  core?: boolean;
}

interface Props {
  items: ToolkitItem[];
}

const { items } = Astro.props;
const core = items.filter((item) => item.core);
const also = items.filter((item) => !item.core);
---

<section class="section section--surface" id="toolkit">
  <div class="container">
    <SectionHeader
      kicker="06 / Toolkit"
      title="Tools I reach for"
      intro="A working stack rather than a logo wall. The common thread is systems that are understandable, observable, and boring to operate."
    />

    <div class="toolkit-core">
      <p class="toolkit-label">Core stack</p>
      <div class="toolkit-items">
        {core.map((item) => (
          <span class="tag tag--core" title={item.usedFor}>
            {item.tool}
          </span>
        ))}
      </div>
    </div>

    <div class="toolkit-also">
      <p class="toolkit-label">Also used</p>
      <div class="toolkit-items">
        {also.map((item) => (
          <span class="tag tag--also" title={item.usedFor}>
            {item.tool}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
