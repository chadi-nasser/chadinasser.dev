---
import SectionHeader from "@/components/SectionHeader.astro";

interface ToolkitItem {
  tool: string;
  layer: string;
  usedFor: string;
}

interface Props {
  items: ToolkitItem[];
}

const { items } = Astro.props;

const layers = [...new Set(items.map((item) => item.layer))];
const groups = layers.map((layer) => ({
  layer,
  items: items.filter((item) => item.layer === layer),
}));
---

<section class="section section--surface" id="toolkit">
  <div class="container">
    <SectionHeader
      kicker="07 / Toolkit"
      title="Tools I reach for"
      intro="A working stack rather than a logo wall. The common thread is systems that are understandable, observable, and boring to operate."
    />

    <div class="toolkit-list">
      {
        groups.map((group) => (
          <div class="toolkit-row">
            <span class="toolkit-layer">{group.layer}</span>
            <div class="toolkit-items">
              {group.items.map((item) => (
                <span class="tag" title={item.usedFor}>
                  {item.tool}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
