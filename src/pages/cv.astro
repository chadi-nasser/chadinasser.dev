---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import site from "@/data/site.json";

const { person, education, experience, certifications, research, toolkit } =
  site;

const updated = new Intl.DateTimeFormat("en", {
  month: "long",
  year: "numeric",
}).format(new Date());

const layers = [...new Set(toolkit.map((item) => item.layer))];
const groups = layers.map((layer) => ({
  layer,
  tools: toolkit
    .filter((item) => item.layer === layer)
    .map((item) => item.tool),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.headline,
  email: `mailto:${person.email}`,
  url: site.meta.url,
  worksFor: {
    "@type": "Organization",
    name: person.currentCompany,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tripoli",
    addressRegion: "North Governorate",
    addressCountry: "LB",
  },
  sameAs: [person.githubUrl, person.linkedinUrl],
};
---

<BaseLayout
  title="CV — Chadi Nasser"
  description="Curriculum vitae for Chadi Nasser, backend, DevOps, and AI engineer in Tripoli, Lebanon."
  jsonLd={jsonLd}
>
  <div class="container cv-page">
    <header class="cv-header">
      <div>
        <h1 class="cv-name">{person.name}</h1>
        <p class="cv-headline">{person.headline}</p>
      </div>
      <div class="cv-contact">
        <a href={`mailto:${person.email}`}>{person.email}</a>
        <a href={person.linkedinUrl} target="_blank" rel="noopener noreferrer">
          {person.linkedinUrl.replace("https://www.", "")}
        </a>
        <a href={person.githubUrl} target="_blank" rel="noopener noreferrer">
          {person.githubUrl.replace("https://", "")}
        </a>
        <a href="https://chadinasser.dev">chadinasser.dev</a>
        <span>{person.location}</span>
        <span>Updated {updated}</span>
      </div>
    </header>

    <div class="cv-actions">
      <button class="btn btn-primary" id="print-cv" type="button">
        <Icon name="printer" />
        Print / Save as PDF
      </button>
      <a class="btn btn-secondary" href="/">← Back to site</a>
    </div>

    <section class="cv-section">
      <h2 class="cv-section-title">Profile</h2>
      <p>{person.professionalSummary}</p>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Experience</h2>
      {
        experience.items.map((item) => (
          <div class="cv-role-block">
            <div class="cv-role">
              <h3>
                {item.role} · {item.company}
              </h3>
              <span>{item.period}</span>
            </div>
            {item.location && <p class="cv-location">{item.location}</p>}
            {item.summary && <p class="cv-summary">{item.summary}</p>}
            {item.highlights.length > 0 && (
              <ul class="cv-list">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Skills</h2>
      <div class="cv-skills">
        {
          groups.map((group) => (
            <p>
              <span>{group.layer}</span>
              {group.tools.join(" · ")}
            </p>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Education &amp; certifications</h2>
      <div class="cv-grid">
        <div>
          <p class="cv-col-title">Education</p>
          {
            education.items.map((item) => (
              <div class="cv-item">
                <p class="cv-item-title">{item.degree}</p>
                <p class="cv-item-meta">
                  {item.institution} · {item.period} · GPA {item.gpa}
                </p>
              </div>
            ))
          }
        </div>
        <div>
          <p class="cv-col-title">Certifications</p>
          {
            certifications.map((item) => (
              <div class="cv-item">
                <p class="cv-item-title">{item.title}</p>
                <p class="cv-item-meta">
                  {item.issuer} · {item.date} · Credential {item.credentialId}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">Research</h2>
      <p>
        <strong>{research.title}</strong> — {research.context}
      </p>
      <p>{research.summary}</p>
    </section>
  </div>

  <script is:inline>
    document.getElementById("print-cv")?.addEventListener("click", () => {
      window.print();
    });
  </script>
</BaseLayout>
