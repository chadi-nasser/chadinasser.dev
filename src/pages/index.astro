---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import About from "@/components/About.astro";
import Contact from "@/components/Contact.astro";
import Credentials from "@/components/Credentials.astro";
import Experience from "@/components/Experience.astro";
import Hero from "@/components/Hero.astro";
import PhotoBand from "@/components/PhotoBand.astro";
import ProjectsLedger from "@/components/ProjectsLedger.astro";
import ProofStrip from "@/components/ProofStrip.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Toolkit from "@/components/Toolkit.astro";
import WritingList from "@/components/WritingList.astro";
import site from "@/data/site.json";

const posts = (await getCollection("blog")).sort((a, b) => {
  const aDate = a.data.date?.getTime() ?? 0;
  const bDate = b.data.date?.getTime() ?? 0;
  return bDate - aDate;
});

const featuredNames = [
  "spring-ecommerce-api",
  "chadinasser.dev",
  "chip-8-emulator",
  "SimpleTerraformInfra",
  "pocketpal-ai",
  "xvru-os",
];

const featured = featuredNames
  .map((name) => site.github.repositories.find((repo) => repo.name === name))
  .filter((repo): repo is (typeof site.github.repositories)[number] =>
    Boolean(repo),
  );

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: site.person.name,
    jobTitle: site.person.headline,
    description: site.person.professionalSummary,
    image: site.person.avatarUrl,
    url: site.meta.url,
    worksFor: {
      "@type": "Organization",
      name: site.person.currentCompany,
    },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Tripoli",
      addressRegion: "North Governorate",
      addressCountry: "LB",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: site.education.items[0].institution,
    },
    sameAs: [site.person.githubUrl, site.person.linkedinUrl],
    knowsAbout: [
      "Java",
      "Spring Boot",
      "Docker",
      "Kubernetes",
      "AWS",
      "Jenkins",
      "Terraform",
      "Linux",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.meta.siteName,
    url: site.meta.url,
    description: site.meta.siteDescription,
    inLanguage: "en",
    author: {
      "@type": "Person",
      name: site.person.name,
    },
  },
];
---

<BaseLayout
  title="Chadi Nasser — Backend & DevOps Engineer"
  description="Chadi Nasser is a backend and DevOps engineer in Tripoli, Lebanon. Java, Spring Boot, Docker, Kubernetes, and AWS."
  jsonLd={jsonLd}
>
  <Hero />
  <ProofStrip />
  <About />
  <Experience items={site.experience.items} />
  <ProjectsLedger
    projects={featured}
    limit={6}
    total={site.github.profile.publicRepos}
  />
  <PhotoBand />
  <Credentials
    education={site.education}
    certifications={site.certifications}
  />
  <section class="section" id="writing">
    <div class="container">
      <SectionHeader
        kicker="05 / Writing"
        title="Notes from the work"
        intro="Occasional writing about the tools, trade-offs, and detours behind the projects."
      />
      <WritingList posts={posts} />
    </div>
  </section>
  <Toolkit items={site.toolkit} />
  <Contact />
</BaseLayout>
