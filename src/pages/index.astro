---
import BaseLayout from "@/layouts/BaseLayout.astro";
import About from "@/components/About.astro";
import Contact from "@/components/Contact.astro";
import Credentials from "@/components/Credentials.astro";
import Experience from "@/components/Experience.astro";
import Hero from "@/components/Hero.astro";
import ProjectsLedger from "@/components/ProjectsLedger.astro";
import Research from "@/components/Research.astro";
import ProofStrip from "@/components/ProofStrip.astro";
import Toolkit from "@/components/Toolkit.astro";
import site from "@/data/site.json";

const featuredNames = [
  "spring-ecommerce-api",
  "chadinasser.dev",
  "chip-8-emulator",
  "SimpleTerraformInfra",
  "xvru-os",
];

const featured = featuredNames
  .map((name) => site.github.repositories.find((repo) => repo.name === name))
  .filter((repo): repo is (typeof site.github.repositories)[number] =>
    Boolean(repo),
  );

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: site.person.name,
    jobTitle: site.person.headline,
    description: site.person.professionalSummary,
    image: site.person.avatarUrl,
    url: site.meta.url,
    worksFor: {
      "@type": "Organization",
      name: site.person.currentCompany,
    },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Tripoli",
      addressRegion: "North Governorate",
      addressCountry: "LB",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: site.education.items[0].institution,
    },
    sameAs: [site.person.githubUrl, site.person.linkedinUrl],
    knowsAbout: [
      "Java",
      "Spring Boot",
      "TypeScript",
      "Rust",
      "Python",
      "PostgreSQL",
      "Liquibase",
      "Snowflake",
      "JWT",
      "OAuth2",
      "OIDC",
      "TOTP",
      "Passkeys",
      "Docker",
      "Kubernetes",
      "AWS",
      "Jenkins",
      "Terraform",
      "Linux",
      "AI",
      "Embedding models",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.meta.siteName,
    url: site.meta.url,
    description: site.meta.siteDescription,
    inLanguage: "en",
    author: {
      "@type": "Person",
      name: site.person.name,
    },
  },
];
---

<BaseLayout
  title="Chadi Nasser — Backend, DevOps & AI Engineer"
  description="Chadi Nasser is a backend, DevOps, and AI engineer in Tripoli, Lebanon. 5+ years with Java, Spring Boot, security, data platforms, Docker, Kubernetes, and AWS."
  jsonLd={jsonLd}
>
  <Hero />
  <ProofStrip />
  <About />
  <Experience items={site.experience.items} />
  <ProjectsLedger projects={featured} limit={5} />
  <Credentials
    education={site.education}
    certifications={site.certifications}
  />
  <Research />
  <Toolkit items={site.toolkit} />
  <Contact />
</BaseLayout>
